NAME = input.inp
|  1> !wB97X-D3 def2-TZVP def2/J RIJCOSX DEFGRID3 TightSCF CPCM(MeCN) Hirshfeld NBO
|  2> %maxcore 1500
|  3> %pal nprocs 8 end
|  4> %elprop
|  5>   Dipole true
|  6>   Quadrupole true
|  7>   Polar true
|  8> end
|  9> %nbo
| 10>   NBOKEYLIST = "$NBO BNDIDX ARCHIVE $END"
| 11> end
| 12> %scf
| 13>   STABPerform true
| 14> end
| 15> 
| 16> *xyzfile 1 2 input.xyz
| 17> 
| 18>                          ****END OF INPUT****
